# 환경 변수 예시 파일입니다. 복사해서 .env.local 로 사용하세요.
# 브라우저에 노출되는 값은 NEXT_PUBLIC_ 접두사를 붙입니다.
NEXT_PUBLIC_APP_NAME=DrugScheduler

# 식약처 의약품 정보 API(공공데이터포털) 인증키. 약 이름이 실제로 있는 약인지 확인하는 데 쓴다.
# 비워 두면 확인하지 않고 입력한 대로 시간표를 만든다. 브라우저에 노출되면 안 되므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
DATA_GO_KR_SERVICE_KEY=
# (선택) API 주소. 비우면 의약품개요정보(e약은요) 제품명 검색 주소를 쓴다.
# DRUG_API_URL=
# (선택) block(기본): 의약품 정보에서 못 찾은 약은 시간표를 만들지 않는다.
# warn: 못 찾아도 안내만 하고 시간표는 만든다(의약품 정보에 없는 영양제 등을 허용할 때).
# DRUG_CHECK_MODE=block
